[Unit]
Description=Cat door controller and website
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/door-venv/bin/python /home/pi/door/door.py
Restart=always
RestartSec=5
StandardOutput=append:/home/pi/door-script.log
StandardError=append:/home/pi/door-script.log

[Install]
WantedBy=multi-user.target
